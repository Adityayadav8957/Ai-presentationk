DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/ai_presentation
REDIS_URL=redis://redis:6379/0

DEFAULT_LLM_PROVIDER=siliconflow
DEFAULT_IMAGE_PROVIDER=siliconflow

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=

# SiliconFlow issues separate keys per platform — a key from siliconflow.com
# will NOT work against api.siliconflow.cn and vice versa (you'll get a
# misleading "Token is invalid" 401 on the wrong domain). Use the domain that
# matches where you created the key.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Ollama runs on your HOST machine, not in a container. Under docker-compose,
# "localhost" from inside the backend/worker containers means the container
# itself, not your host — use host.docker.internal instead. If you run the
# backend directly on the host (no Docker), use localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Same host.docker.internal reasoning: Playwright runs inside the
# backend/worker container and needs to reach the frontend dev server on
# your host to screenshot slides for QA.
FRONTEND_RENDER_URL=http://host.docker.internal:3000

# This one IS "localhost" on purpose — it's read by the browser on your
# host machine (to load generated images), not by code inside a container.
PUBLIC_BACKEND_URL=http://localhost:8000
